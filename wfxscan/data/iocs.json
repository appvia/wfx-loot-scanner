    {"subject": "chore: add ci helper", "severity_ci": "CRITICAL", "severity_other": "MEDIUM", "window_only": false, "description": "adds .ci-xxxxxx.sh and an npm postinstall hook", "source": "aikido, safedep"},
    {"subject": "chore: add dependency audit workflow", "severity_ci": "CRITICAL", "severity_other": "HIGH", "window_only": false, "description": "adds .github/workflows/build-audit-xxxxxx.yml", "source": "aikido, safedep"},
    {"subject": "docs: dependency audit notes", "severity_ci": "HIGH", "severity_other": "HIGH", "window_only": false, "description": "probe commit", "source": "aikido, safedep"},
    {"subject": "chore: initial commit", "severity_ci": "MEDIUM", "severity_other": null, "window_only": true, "description": "pushed to empty repositories before the new workflow file", "source": "safedep"},
    {"subject": "ci: restore", "severity_ci": "MEDIUM", "severity_other": null, "window_only": true, "description": "clean-up commit that removes the payload", "source": "aikido, safedep"},
    {"subject": "ci: cleanup", "severity_ci": "MEDIUM", "severity_other": null, "window_only": true, "description": "clean-up commit that removes the payload", "source": "aikido, safedep"}
  ],

  "compromised_authors": [
    {"login": "wdio-bot", "severity": "MEDIUM", "description": "bot account whose token was used to push the payload", "source": "safedep"}
  ],

  "payload_paths": [
